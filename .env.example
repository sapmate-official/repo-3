NODE_ENV=development
PORT=5001

# Neon database connection URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Independent secrets per token type (min 32 chars, high entropy)
USER_ACCESS_TOKEN_SECRET=
USER_REFRESH_TOKEN_SECRET=
SUPER_ADMIN_ACCESS_TOKEN_SECRET=
SUPER_ADMIN_REFRESH_TOKEN_SECRET=
# HMAC key used to hash OTP codes at rest
OTP_HASH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Legacy verification tokens have no expiry column value; bound them with this grace period
LEGACY_VERIFICATION_TOKEN_TTL=14d
# bcrypt cost (10-15). 12+ recommended.
PASSWORD_HASH_ROUNDS=12

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Must be a literal "true" or "false"
COOKIE_SECURE=false
# Leave empty for localhost; set to your cookie domain (e.g. .alkaa.online) in production
COOKIE_DOMAIN=

JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
# Express trust proxy setting: false, true, a hop count, or a subnet list
TRUST_PROXY=false
# Optional. Set in production when running more than one instance so rate limits are shared.
REDIS_URL=
# Optional. Organization that receives public demo requests. If unset, requests are emailed but not added to onboarding.
PUBLIC_DEMO_ORG_ID=

LOG_LEVEL=info

